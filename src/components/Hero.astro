---
import { Image } from 'astro:assets';
import { SITE } from '../data/site';
import heroImg from '../assets/img/home/banner-1.jpg';
---

<section id="inicio" class="relative flex min-h-screen items-center overflow-hidden">
  <!-- Fondo ambiental -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div
      class="absolute -top-32 -right-32 h-[500px] w-[500px] rounded-full bg-gradient-to-br from-teal/10 to-navy/5 blur-3xl"
      data-parallax="-0.15"
    >
    </div>
    <div
      class="absolute -bottom-24 -left-24 h-[420px] w-[420px] rounded-full bg-gradient-to-tr from-terracotta/10 to-teal/5 blur-3xl"
      data-parallax="0.1"
    >
    </div>
    <div class="dot-grid absolute inset-0 opacity-40"></div>
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-4 pt-28 pb-16 sm:px-6 md:pt-32 md:pb-20 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Texto -->
      <div class="order-2 text-center lg:order-1 lg:text-left">
        <div data-animate="up" class="mb-5">
          <span class="inline-flex items-center gap-2 rounded-full bg-teal/10 px-4 py-1.5 text-sm font-medium text-navy">
            <span class="h-2 w-2 animate-pulse rounded-full bg-teal"></span>
            Clínica dental en Santiago, R.D.
          </span>
        </div>

        <h1
          id="hero-headline"
          class="mb-6 font-heading text-4xl leading-[1.05] font-bold text-navy sm:text-5xl lg:text-6xl xl:text-7xl"
        >
          <span class="hero-word inline-block">Es</span>
          <span class="hero-word inline-block">el</span>
          <span class="hero-word inline-block">turno</span>
          <span class="hero-word inline-block">de</span>
          <span class="hero-word inline-block">tu</span>
          <span class="hero-word text-gradient inline-block">sonrisa</span>
        </h1>

        <p
          data-animate="up"
          data-delay="0.5"
          class="mx-auto mb-8 max-w-xl text-lg leading-relaxed text-muted-foreground sm:text-xl lg:mx-0"
        >
          Inspirados en la más avanzada tecnología y un trato humano, en
          <strong class="font-semibold text-navy">JS Dental Group</strong> te ofrecemos una experiencia
          única para que sonrías sin límites.
        </p>

        <div data-animate="up" data-delay="0.65" class="flex flex-col justify-center gap-4 sm:flex-row lg:justify-start">
          <a
            href={SITE.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-teal px-8 py-4 text-base font-semibold text-white shadow-lg shadow-teal/25 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-teal/30"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path>
            </svg>
            Agenda tu cita por WhatsApp
          </a>
          <a
            href="#servicios"
            class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-navy/15 px-8 py-4 text-base font-semibold text-navy transition-all duration-300 hover:-translate-y-0.5 hover:border-teal hover:text-teal"
          >
            Nuestros servicios
          </a>
        </div>

        <!-- Indicadores de confianza con contadores -->
        <div
          data-animate="up"
          data-delay="0.8"
          class="mt-12 flex flex-wrap items-center justify-center gap-8 lg:justify-start"
        >
          <div class="text-center lg:text-left">
            <p class="font-heading text-3xl font-bold text-navy">
              <span data-count="1000" data-count-suffix="+">0</span>
            </p>
            <p class="text-sm text-muted-foreground">Pacientes felices</p>
          </div>
          <div class="h-10 w-px bg-border" aria-hidden="true"></div>
          <div class="text-center lg:text-left">
            <p class="font-heading text-3xl font-bold text-navy">
              <span data-count="9">0</span>
            </p>
            <p class="text-sm text-muted-foreground">Especialistas certificados</p>
          </div>
          <div class="h-10 w-px bg-border" aria-hidden="true"></div>
          <div class="text-center lg:text-left">
            <p class="font-heading text-3xl font-bold text-navy">Desde 2020</p>
            <p class="text-sm text-muted-foreground">Cuidando sonrisas</p>
          </div>
        </div>
      </div>

      <!-- Imagen en arco (firma visual: arco dental) -->
      <div class="order-1 flex justify-center lg:order-2" data-animate="scale" data-delay="0.3">
        <div class="relative w-[320px] sm:w-[400px] lg:w-[460px]">
          <div class="overflow-hidden rounded-t-full rounded-b-[2.5rem] border-8 border-white shadow-2xl shadow-navy/15">
            <Image
              src={heroImg}
              alt="Paciente sonriendo en JS Dental Group, clínica dental en Santiago"
              width={920}
              widths={[460, 920]}
              sizes="(max-width: 640px) 320px, (max-width: 1024px) 400px, 460px"
              loading="eager"
              fetchpriority="high"
              class="aspect-[4/5] h-auto w-full object-cover"
            />
          </div>

          <!-- Arco de sonrisa dibujado por scroll -->
          <svg
            class="smile-arc pointer-events-none absolute -bottom-10 left-1/2 w-[120%] -translate-x-1/2"
            viewBox="0 0 400 120"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M20 20 C 110 130, 290 130, 380 20"
              stroke="oklch(0.71 0.09 187)"
              stroke-width="6"
              stroke-linecap="round"
              pathLength="1"
            ></path>
          </svg>

          <!-- Chip flotante -->
          <div
            class="absolute -left-6 top-10 hidden rounded-2xl bg-white/90 px-5 py-3 shadow-lg backdrop-blur sm:block"
            data-parallax="-0.08"
          >
            <p class="text-sm font-semibold text-navy">Sonríe con confianza</p>
            <p class="text-xs text-muted-foreground">Atención para toda la familia</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import gsap from 'gsap';

    const words = document.querySelectorAll('#hero-headline .hero-word');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && words.length) {
      gsap.from(words, {
        yPercent: 110,
        opacity: 0,
        rotateX: -40,
        duration: 0.9,
        ease: 'power4.out',
        stagger: 0.08,
        delay: 0.1,
      });
    }
  </script>
</section>
