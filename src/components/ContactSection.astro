---
import { SITE } from '../data/site';

interface Props {
  heading?: string;
}

const { heading = '¿Tienes dudas? Agenda tu consulta' } = Astro.props;
const waNumber = SITE.phone.replace('+', '');
---

<section id="contacto" class="py-24 md:py-32">
  <div class="container">
    <div class="mx-auto grid max-w-5xl gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-animate="left">
        <h2 class="mb-4 font-heading text-4xl font-bold text-navy md:text-5xl">{heading}</h2>
        <p class="mb-8 text-lg text-muted-foreground">
          Nuestro equipo de especialistas está listo para resolver tus dudas y ayudarte a conseguir
          la mejor versión de tu sonrisa. Completa el formulario y te contactamos a la brevedad.
        </p>

        <ul class="space-y-4 text-foreground">
          <li>
            <p class="text-sm font-semibold text-navy">Teléfono</p>
            <a href={`tel:${SITE.phone}`} class="text-lg hover:text-teal">{SITE.phoneDisplay}</a>
          </li>
          <li>
            <p class="text-sm font-semibold text-terracotta">Emergencias</p>
            <a href={`tel:${SITE.emergencyPhone}`} class="text-lg hover:text-teal">
              {SITE.emergencyPhoneDisplay}
            </a>
          </li>
          <li>
            <p class="text-sm font-semibold text-navy">Correo</p>
            <a href={`mailto:${SITE.email}`} class="text-lg hover:text-teal">{SITE.email}</a>
          </li>
          <li>
            <p class="text-sm font-semibold text-navy">Dirección</p>
            <p class="text-lg">{SITE.address.street}, {SITE.address.city}, R.D.</p>
          </li>
          <li>
            <p class="text-sm font-semibold text-navy">Horario</p>
            <p class="text-lg">{SITE.hours.weekdays}<br />{SITE.hours.saturday}</p>
          </li>
        </ul>
      </div>

      <form
        id="consulta-form"
        data-animate="right"
        data-wa={waNumber}
        class="flex flex-col gap-4 rounded-2xl border bg-card p-8 shadow-sm"
      >
        <div>
          <label for="cf-nombre" class="mb-1.5 block text-sm font-medium text-navy">Nombre completo *</label>
          <input
            id="cf-nombre"
            name="nombre"
            type="text"
            required
            autocomplete="name"
            class="h-11 w-full rounded-md border border-input bg-background px-4 text-base focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
          />
        </div>
        <div>
          <label for="cf-telefono" class="mb-1.5 block text-sm font-medium text-navy">Número de teléfono</label>
          <input
            id="cf-telefono"
            name="telefono"
            type="tel"
            autocomplete="tel"
            class="h-11 w-full rounded-md border border-input bg-background px-4 text-base focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
          />
        </div>
        <div>
          <label for="cf-asunto" class="mb-1.5 block text-sm font-medium text-navy">Asunto *</label>
          <input
            id="cf-asunto"
            name="asunto"
            type="text"
            required
            class="h-11 w-full rounded-md border border-input bg-background px-4 text-base focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
          />
        </div>
        <div>
          <label for="cf-mensaje" class="mb-1.5 block text-sm font-medium text-navy">Tu pregunta *</label>
          <textarea
            id="cf-mensaje"
            name="mensaje"
            rows="4"
            required
            class="w-full rounded-md border border-input bg-background px-4 py-3 text-base focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"></textarea>
        </div>
        <button
          type="submit"
          class="mt-2 inline-flex items-center justify-center gap-2 rounded-full bg-teal px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-teal/25 transition-all duration-300 hover:-translate-y-0.5"
        >
          Enviar por WhatsApp
        </button>
        <p class="text-center text-xs text-muted-foreground">
          Al enviar se abrirá WhatsApp con tu mensaje listo para nuestro equipo.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('consulta-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const texto = [
      `Hola, soy ${data.get('nombre')}.`,
      data.get('telefono') ? `Mi teléfono: ${data.get('telefono')}.` : '',
      `Asunto: ${data.get('asunto')}.`,
      `${data.get('mensaje')}`,
    ]
      .filter(Boolean)
      .join('\n');
    const wa = form.dataset.wa;
    window.open(`https://wa.me/${wa}?text=${encodeURIComponent(texto)}`, '_blank', 'noopener');
  });
</script>
