---
import { Navbar17 } from './navbar17';
import { SITE, SERVICE_KEYS, hours } from '../data/site';
import { IMAGES } from '../lib/images';
import { LOCALES, ROUTES, servicePath, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** URL equivalente de esta página en cada idioma (para el selector) */
  paths: Record<Lang, string>;
}

const { lang, paths } = Astro.props;
const t = useTranslations(lang);
const h = hours(lang);

const items = [
  { name: t.nav.home, link: ROUTES.home[lang] },
  {
    name: t.nav.services,
    link: ROUTES.services[lang],
    hasSubmenu: true,
    submenu: SERVICE_KEYS.map((key) => ({
      title: t.services[key].name,
      href: servicePath(key, lang),
      description: t.services[key].tagline,
    })),
  },
  { name: t.nav.about, link: ROUTES.about[lang] },
  { name: t.nav.contact, link: ROUTES.contact[lang] },
];

const languages = LOCALES.map((l) => {
  const d = useTranslations(l);
  return { label: d.label, labelShort: d.labelShort, href: paths[l], active: l === lang };
});

const copy = {
  allServices: t.nav.allServices,
  book: t.nav.book,
  bookWhatsapp: t.nav.bookWhatsapp,
  call: t.nav.call,
  callAria: t.nav.callAria(SITE.phoneDisplay),
  openMenu: t.nav.openMenu,
  closeMenu: t.nav.closeMenu,
  homeAria: t.nav.homeAria,
  mainMenu: t.nav.mainMenu,
  switchLanguage: t.nav.switchLanguage,
  hoursWeekdays: h.weekdays,
  hoursSaturday: h.saturday,
  phoneDisplay: SITE.phoneDisplay,
};

const currentPath = Astro.url.pathname;
---

<a
  href="#contenido"
  class="sr-only z-[60] rounded-md bg-teal-strong px-4 py-2 font-semibold text-white focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
>
  {t.nav.skipToContent}
</a>

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-transform duration-300 ease-out">
  <Navbar17
    client:idle
    logoSrc={IMAGES.logo}
    whatsapp={SITE.whatsapp}
    phone={SITE.phone}
    items={items}
    languages={languages}
    t={copy}
    currentPath={currentPath}
  />
</header>

<script>
  // Header inteligente: se oculta al bajar, reaparece al subir.
  const header = document.getElementById('site-header');
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      const goingDown = y > lastY;
      const menuOpen = !!document.querySelector('[data-state="open"]');

      if (y < 80 || menuOpen) header.style.transform = 'translateY(0)';
      else if (goingDown && y - lastY > 4) header.style.transform = 'translateY(-110%)';
      else if (!goingDown && lastY - y > 4) header.style.transform = 'translateY(0)';

      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>
