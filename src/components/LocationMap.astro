---
import { SITE, hours } from '../data/site';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** en el home lleva titular; en la página de contacto va sin él */
  withHeading?: boolean;
}

const { lang, withHeading = false } = Astro.props;
const t = useTranslations(lang);
const h = hours(lang);
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(SITE.address.mapQuery)}&hl=${lang}&output=embed`;
---

<section class="pb-24" aria-label={t.contact.mapAria}>
  <div class="container">
    {
      withHeading && (
        <div class="mb-8 flex flex-col gap-4 text-center" data-animate="up">
          <h2 class="font-heading text-4xl font-bold text-navy md:text-5xl">{t.contact.labelAddress}</h2>
          <p class="text-lg text-muted-foreground">
            {SITE.address.street}, {SITE.address.city} · {h.weekdays}
          </p>
        </div>
      )
    }
    <div
      class="h-[420px] overflow-hidden rounded-2xl border bg-muted/40 shadow-sm"
      data-map-frame={mapSrc}
      data-map-title={t.contact.mapTitle}
      data-animate="up"
    >
      <noscript>
        <iframe
          title={t.contact.mapTitle}
          src={mapSrc}
          width="100%"
          height="420"
          class="border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </noscript>
    </div>
  </div>
</section>

<script>
  // El mapa se monta al acercarse: evita el coste de Google Maps en el arranque
  const holder = document.querySelector<HTMLElement>('[data-map-frame]');
  if (holder) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const iframe = document.createElement('iframe');
        iframe.src = holder.dataset.mapFrame!;
        iframe.title = holder.dataset.mapTitle!;
        iframe.style.cssText = 'width:100%;height:100%;border:0;display:block';
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'no-referrer-when-downgrade';
        iframe.allowFullscreen = true;
        holder.appendChild(iframe);
      },
      { rootMargin: '400px 0px' },
    );
    io.observe(holder);
  }
</script>
