---
// Feed real de Instagram embebido (patrón de la rama lpascual)
interface Props {
  username: string;
  heading?: string;
  description?: string;
}

const {
  username,
  heading = 'Nuestra sonrisa también está en Instagram',
  description = 'Momentos reales de nuestros pacientes y nuestro equipo.',
} = Astro.props;

const embedUrl = `https://www.instagram.com/${username}/embed`;
---

<section class="py-24 md:py-32" aria-label="Instagram de la clínica">
  <div class="container">
    <div class="mb-10 flex flex-col gap-4 text-center" data-animate="up">
      <h2 class="font-heading text-4xl font-bold text-navy md:text-5xl">{heading}</h2>
      <p class="text-lg text-muted-foreground">
        {description}
        <a
          href={`https://www.instagram.com/${username}/`}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-teal hover:underline">@{username}</a
        >
      </p>
    </div>

    <div class="flex w-full justify-center" data-animate="up" data-delay="0.15">
      <div class="ig-frame w-full overflow-hidden rounded-2xl border shadow-sm">
        <iframe
          src={embedUrl}
          class="absolute inset-0 h-full w-full border-none"
          scrolling="no"
          title={`Instagram de @${username}`}
          loading="lazy"></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  /* El embed muestra cabecera de perfil + 2 filas de 3 miniaturas cuadradas:
     su alto real, medido a 364/589/1126/1510px de ancho, es 0.676*ancho + 147.
     El padding-bottom en % se calcula sobre el ancho, así el marco se ajusta
     al contenido en cualquier pantalla: ni hueco blanco ni recorte. */
  .ig-frame {
    position: relative;
    height: 0;
    padding-bottom: calc(66.7% + 158px);
  }
</style>
