---
// Feed real de Instagram embebido (patrón de la rama lpascual)
interface Props {
  username: string;
  heading: string;
  description: string;
  frameTitle: string;
}

const { username, heading, description, frameTitle } = Astro.props;
const embedUrl = `https://www.instagram.com/${username}/embed`;
---

<section id="instagram" class="py-24 md:py-32" aria-label={frameTitle}>
  <div class="container">
    <div class="mb-10 flex flex-col gap-4 text-center" data-animate="up">
      <h2 class="font-heading text-4xl font-bold text-navy md:text-5xl">{heading}</h2>
      <p class="text-lg text-muted-foreground">
        {description}
        <a
          href={`https://www.instagram.com/${username}/`}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-teal hover:underline">@{username}</a
        >
      </p>
    </div>

    <div class="ig-wrap flex w-full justify-center" data-animate="up" data-delay="0.15">
      <div class="ig-frame w-full overflow-hidden rounded-2xl border bg-muted/40 shadow-sm" data-ig-frame={embedUrl}>
        <noscript>
          <iframe src={embedUrl} scrolling="no" title={frameTitle} loading="lazy"></iframe>
        </noscript>
      </div>
    </div>
  </div>
</section>

<style>
  /*
    El embed de Instagram reflowea para RELLENAR el alto que se le da: si sobra
    espacio empieza una tercera fila y se ve cortada. La solución es no dejar
    que lo decida él:

    1. El iframe se declara más alto que el marco (renderiza 3+ filas).
    2. El marco recorta exactamente a la cabecera + 2 filas completas.

    Medido en el embed real: la retícula empieza a 147px (ancho < 480px) o a
    157px (ancho >= 480px, breakpoint propio de Instagram) y cada celda es
    cuadrada = ancho/3, así que 2 filas = 66.667% del ancho. El padding-bottom
    en % se calcula sobre el ancho, por eso encaja en cualquier pantalla.
  */
  .ig-wrap {
    container-type: inline-size;
  }

  .ig-frame {
    position: relative;
    height: 0;
    padding-bottom: calc(66.667% + 147px);
  }

  @container (min-width: 480px) {
    .ig-frame {
      padding-bottom: calc(66.667% + 157px);
    }
  }

  .ig-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    /* más alto que el marco: el embed maqueta 3 filas y recortamos a 2 */
    height: calc(100% + 420px);
    border: none;
  }
</style>

<script>
  // El iframe se inserta al acercarse a la sección: así no descarga ~600 KB
  // en el arranque y la página conserva el bfcache hasta que hace falta.
  const frame = document.querySelector<HTMLElement>('[data-ig-frame]');
  if (frame) {
    const mount = () => {
      if (frame.querySelector('iframe:not(noscript iframe)')) return;
      const iframe = document.createElement('iframe');
      iframe.src = frame.dataset.igFrame!;
      iframe.scrolling = 'no';
      iframe.loading = 'lazy';
      // el CSS de .ig-frame iframe lo posiciona; se fija aquí también por si
      // el navegador aún no aplicó la hoja al insertarlo
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:calc(100% + 420px);border:none';
      iframe.title = frame.closest('section')?.getAttribute('aria-label') ?? 'Instagram';
      frame.appendChild(iframe);
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          mount();
        }
      },
      { rootMargin: '600px 0px' },
    );
    io.observe(frame);
  }
</script>
