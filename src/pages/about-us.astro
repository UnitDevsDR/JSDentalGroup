---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FooterSection from '../components/FooterSection.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import ContactSection from '../components/ContactSection.astro';
import { About1 } from '../components/about1';
import { Team13 } from '../components/team13';
import { SITE, TEAM } from '../data/site';

import banner1 from '../assets/img/home/banner-1.jpg';
import banner2 from '../assets/img/home/banner-2.jpg';

import julissa from '../assets/img/team/julissa-saint-hilaire.webp';
import rosangel from '../assets/img/team/rosangel-tatis.png';
import melissa from '../assets/img/team/melissa-lantigua.webp';
import mairenys from '../assets/img/team/mairenys-estevez.webp';
import denisse from '../assets/img/team/denisse-dominguez.png';
import siddy from '../assets/img/team/siddy-dominguez.png';
import laura from '../assets/img/team/laura-bueno.png';
import simon from '../assets/img/team/simon-dominguez.png';
import rosanny from '../assets/img/team/rosanny-minaya.png';
import arianny from '../assets/img/team/arianny-pena.webp';

const TEAM_IMAGES: Record<string, ImageMetadata> = {
  'julissa-saint-hilaire': julissa,
  'rosangel-tatis': rosangel,
  'melissa-lantigua': melissa,
  'mairenys-estevez': mairenys,
  'denisse-dominguez': denisse,
  'siddy-dominguez': siddy,
  'laura-bueno': laura,
  'simon-dominguez': simon,
  'rosanny-minaya': rosanny,
  'arianny-pena': arianny,
};

const [historia, mision] = await Promise.all([
  getImage({ src: banner1, width: 900 }),
  getImage({ src: banner2, width: 900 }),
]);

const members = await Promise.all(
  TEAM.map(async (m) => ({
    name: m.name,
    role: m.role,
    imageSrc: (await getImage({ src: TEAM_IMAGES[m.image], width: 480 })).src,
  })),
);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Sobre nosotros', item: `${SITE.url}/about-us` },
  ],
};
---

<Layout
  title="Sobre Nosotros | Historia y Especialistas | JS Dental Group"
  description="Conoce la historia de J Saint Hilaire Dental Expert Group: un equipo multidisciplinario de especialistas dentales en Santiago, R.D., fundado en 2020. Ética, respeto y amor por lo que hacemos."
  extraSchema={[breadcrumbSchema]}
>
  <SiteHeader />

  <main class="pt-20">
    <About1 historyImageSrc={historia.src} missionImageSrc={mision.src} />
    <Team13 client:visible members={members} whatsapp={SITE.whatsapp} />
    <ContactSection />
  </main>

  <FooterSection />
  <WhatsAppFloat />
</Layout>
