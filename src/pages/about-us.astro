---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FooterSection from '../components/FooterSection.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { Contact2 } from '../components/contact2';
import { About13 } from '../components/about13';
import { TeamProfiles } from '../components/user-profile10';
import { SITE, TEAM } from '../data/site';
import { IMAGES, teamPhoto } from '../lib/images';



const doctors = TEAM.map((m) => ({
  name: m.name,
  role: m.role,
  imageSrc: teamPhoto(m.image, 'md'),
  verified: m.name.startsWith('Dr'),
}));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Sobre nosotros', item: `${SITE.url}/about-us` },
  ],
};
---

<Layout
  title="Sobre Nosotros | Historia y Especialistas | JS Dental Group"
  description="Conoce la historia de J Saint Hilaire Dental Expert Group: un equipo multidisciplinario de especialistas dentales en Santiago, R.D., fundado en 2020. Ética, respeto y amor por lo que hacemos."
  extraSchema={[breadcrumbSchema]}
>
  <SiteHeader />

  <main id="contenido" class="pt-20">
    <About13
      title="Historia de la clínica"
      sideLabel="Nuestra historia"
      intro="En el año 2020 nace J Saint Hilaire Dental Expert Group, un sueño hecho realidad que surge del deseo de ofrecer una atención odontológica integral, moderna y basada en el trabajo en equipo."
      founder={{ name: 'Dra. Julissa Saint-Hilaire Espinal', role: 'Fundadora y Gerente General', imageSrc: teamPhoto('julissa-saint-hilaire', 'lg') }}
      statement="Más que una clínica, somos un grupo de expertos comprometidos con brindar soluciones funcionales y estéticas, trabajando de forma multidisciplinaria para abordar cada caso con la máxima excelencia."
      support="Cada especialista aporta su granito de arena, garantizando tratamientos más completos, personalizados y exitosos. Nuestro objetivo no es solo cuidar sonrisas, sino construir relaciones de confianza con cada paciente, guiados siempre por la ética, el respeto y el amor por lo que hacemos."
      image={{ src: IMAGES.clinica, alt: 'JS Dental Group, clínica dental en Santiago de los Caballeros' }}
    />
    <TeamProfiles doctors={doctors} whatsapp={SITE.whatsapp} />
    <div data-animate="up">
      <Contact2 client:visible />
    </div>
  </main>

  <FooterSection />
  <WhatsAppFloat />
</Layout>
