---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FooterSection from '../components/FooterSection.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { Hero127 } from '../components/hero127';
import { Logos12 } from '../components/logos12';
import { Feature101 } from '../components/feature101';
import { Team13 } from '../components/team13';
import { Gallery29 } from '../components/gallery29';
import { Faq1 } from '../components/faq1';
import { Cta15 } from '../components/cta15';
import { Contact2 } from '../components/contact2';
import { SITE, SERVICES, TEAM, FAQS } from '../data/site';
import { TEAM_IMAGES } from '../lib/team-images';

import heroImg from '../assets/img/home/clinica-1.png';
import ctaImg from '../assets/img/home/clinica-2.png';
import ig1 from '../assets/img/home/ig-1.webp';
import ig2 from '../assets/img/home/ig-2.webp';
import ig3 from '../assets/img/home/ig-3.webp';
import ig4 from '../assets/img/home/ig-4.webp';
import ig5 from '../assets/img/home/ig-5.png';

const opt = (src: ImageMetadata, width: number) => getImage({ src, width });

// Anchos limitados a la resolución nativa de cada fuente (sin upscaling)
const [heroOpt, ctaOpt, destacadoOpt] = await Promise.all([
  opt(heroImg, 772),
  opt(ctaImg, 711),
  opt(ig5, 800),
]);

const igOpt = await Promise.all([ig1, ig2, ig3, ig4].map((i) => opt(i, 500)));

const members = await Promise.all(
  TEAM.map(async (m) => ({
    name: m.name,
    role: m.role,
    imageSrc: (await opt(TEAM_IMAGES[m.image], 480)).src,
  })),
);

// Avatares del hero: 4 doctoras reales (social proof)
const heroAvatars = members
  .filter((m) => m.name.startsWith('Dr'))
  .slice(0, 4)
  .map((m) => ({ src: m.imageSrc, alt: m.name }));

const services = SERVICES.map((s) => ({
  slug: s.slug,
  name: s.name,
  tagline: s.tagline,
  icon: s.icon,
  copy: s.copy,
}));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="JS Dental Group — Clínica Dental en Santiago | Ortodoncia e Implantes"
  description="Clínica dental en Santiago, República Dominicana. Especialistas en ortodoncia, implantes dentales, endodoncia, periodoncia, cirugía maxilofacial y odontopediatría. Atención integral para toda la familia. Agenda tu cita."
  extraSchema={[faqSchema]}
>
  <SiteHeader />

  <main>
    <Hero127
      badge={{ text: 'Santiago, R.D.', announcement: 'Atención para toda la familia', url: '#contacto' }}
      headingWords={['Es', 'el', 'turno', 'de', 'tu']}
      highlightWord="sonrisa"
      description="Inspirados en la más avanzada tecnología y un trato humano, en JS Dental Group te ofrecemos una experiencia única para que sonrías sin límites."
      buttons={{
        primary: { text: 'Agenda tu cita por WhatsApp', url: SITE.whatsapp },
        secondary: { text: 'Nuestros servicios', url: '#servicios' },
      }}
      stats={[
        { count: 1000, suffix: '+', label: 'Pacientes felices' },
        { count: 9, label: 'Especialistas' },
        { value: '2020', label: 'Cuidando sonrisas' },
      ]}
      avatars={heroAvatars}
      avatarsUrl="/about-us"
      image={{ src: heroOpt.src, alt: 'Especialistas de JS Dental Group, clínica dental en Santiago' }}
    />

    <Logos12 items={SERVICES.map((s) => ({ name: s.name, href: `/${s.slug}`, icon: s.icon }))} />

    <Feature101
      heading="Nuestros servicios"
      description="Descubre todo lo que puedes lograr con una atención dental de primer nivel."
      services={services}
    />

    <Cta15
      byline="Cuidamos tu sonrisa"
      heading="Con la ciencia de hoy y la pasión de siempre"
      description="Un grupo de expertos que trabaja de forma multidisciplinaria para abordar cada caso con la máxima excelencia: tratamientos más completos, personalizados y exitosos."
      image={{ src: ctaOpt.src, alt: 'Paciente feliz con su sonrisa en JS Dental Group' }}
      buttons={{
        primary: { text: 'Agenda tu cita', url: SITE.whatsapp },
        secondary: { text: 'Conoce la clínica', url: '/about-us' },
      }}
    />

    <Team13 client:visible members={members} whatsapp={SITE.whatsapp} />

    <Gallery29
      heading="Nuestra sonrisa también está en Instagram"
      description="Momentos reales de nuestros pacientes y nuestro equipo."
      images={igOpt.map((img, i) => ({ src: img.src, alt: `JS Dental Group en Instagram ${i + 1}` }))}
      featured={{ src: destacadoOpt.src, alt: 'JS Dental Group en Instagram' }}
      instagramUrl={SITE.instagram}
    />

    <section class="py-24 md:py-32" data-animate="up">
      <Faq1
        client:visible
        heading="Preguntas frecuentes"
        items={FAQS.map((f, i) => ({ id: `faq-${i + 1}`, question: f.q, answer: f.a }))}
        className="py-0"
      />
    </section>

    <Contact2 client:visible />
  </main>

  <FooterSection />
  <WhatsAppFloat />
</Layout>
