---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FooterSection from '../components/FooterSection.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { Hero127 } from '../components/hero127';
import { Integration6 } from '../components/integration6';
import { Feature101 } from '../components/feature101';
import { TeamProfiles } from '../components/user-profile10';
import InstagramEmbed from '../components/InstagramEmbed.astro';
import { Faq11 } from '../components/faq11';
import { Cta15 } from '../components/cta15';
import { Contact2 } from '../components/contact2';
import { SITE, SERVICES, TEAM, FAQS } from '../data/site';
import { IMAGES, serviceIcon, teamPhoto } from '../lib/images';


const doctors = TEAM.map((m) => ({
  name: m.name,
  role: m.role,
  imageSrc: teamPhoto(m.image, 'md'),
  verified: m.name.startsWith('Dr'),
}));

// Avatares del hero: doctores reales visualmente distintos (social proof)
const HERO_DOCTOR_KEYS = ['julissa-saint-hilaire', 'simon-dominguez', 'rosanny-minaya', 'laura-bueno'];
const heroAvatars = HERO_DOCTOR_KEYS.map((key) => ({
  src: teamPhoto(key, 'sm'),
  alt: TEAM.find((m) => m.image === key)!.name,
}));

// Carrusel del hero: foto de equipo + especialistas destacados
const HERO_SLIDE_KEYS = [
  'julissa-saint-hilaire',
  'simon-dominguez',
  'rosanny-minaya',
  'laura-bueno',
  'siddy-dominguez',
];
const heroSlides = [
  {
    src: IMAGES.heroEspecialistas,
    name: 'Sonríe con confianza',
    role: 'Atención para toda la familia',
    alt: 'Especialistas de JS Dental Group, clínica dental en Santiago',
  },
  ...HERO_SLIDE_KEYS.map((key) => {
    const m = TEAM.find((t) => t.image === key)!;
    return {
      src: teamPhoto(key, 'lg'),
      name: m.name,
      role: m.role,
      alt: `${m.name}, ${m.role} en JS Dental Group`,
    };
  }),
];

const services = SERVICES.map((s) => ({
  slug: s.slug,
  name: s.name,
  tagline: s.tagline,
  copy: s.copy,
  iconSrc: serviceIcon(s.slug),
}));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="JS Dental Group — Clínica Dental en Santiago | Ortodoncia e Implantes"
  description="Clínica dental en Santiago, República Dominicana. Especialistas en ortodoncia, implantes dentales, endodoncia, periodoncia, cirugía maxilofacial y odontopediatría. Atención integral para toda la familia. Agenda tu cita."
  extraSchema={[faqSchema]}
>
  <SiteHeader />

  <main id="contenido">
    <Hero127
      badge={{
        text: 'Santiago, R.D.',
        announcement: 'Atención para toda la familia',
        announcementShort: 'Toda la familia',
        url: '#contacto',
      }}
      headingWords={['Es', 'el', 'turno', 'de', 'tu']}
      highlightWord="sonrisa"
      description="Inspirados en la más avanzada tecnología y un trato humano, en JS Dental Group te ofrecemos una experiencia única para que sonrías sin límites."
      buttons={{
        primary: { text: 'Agenda tu cita por WhatsApp', url: SITE.whatsapp },
        secondary: { text: 'Nuestros servicios', url: '#servicios' },
      }}
      stats={[
        { count: 1000, suffix: '+', label: 'Pacientes felices' },
        { count: 9, label: 'Especialistas' },
        { value: '2020', label: 'Cuidando sonrisas' },
      ]}
      avatars={heroAvatars}
      avatarsUrl="/about-us"
      slides={heroSlides}
    />

    <div data-animate="up">
      <Integration6
        client:visible
        heading="Ocho especialidades, un solo equipo"
        description="Cada tratamiento se aborda en conjunto entre nuestros especialistas, para que tu atención sea completa de principio a fin."
        ctaText="Ver todos los servicios"
        ctaHref="/our-services"
        items={SERVICES.map((s) => ({ name: s.name, href: `/${s.slug}` }))}
        avatars={heroAvatars}
      />
    </div>

    <Feature101
      heading="Nuestros servicios"
      description="Descubre todo lo que puedes lograr con una atención dental de primer nivel."
      services={services}
    />

    <Cta15
      byline="Cuidamos tu sonrisa"
      heading="Con la ciencia de hoy y la pasión de siempre"
      description="Un grupo de expertos que trabaja de forma multidisciplinaria para abordar cada caso con la máxima excelencia: tratamientos más completos, personalizados y exitosos."
      image={{ src: IMAGES.dienteCuidado3d, alt: 'Ilustración 3D: dentistas cuidando un diente gigante' }}
      highlights={[
        'Tecnología de vanguardia',
        'Equipo multidisciplinario certificado',
        'Atención para toda la familia',
      ]}
      buttons={{
        primary: { text: 'Agenda tu cita', url: SITE.whatsapp },
        secondary: { text: 'Conoce la clínica', url: '/about-us' },
      }}
    />

    <TeamProfiles doctors={doctors} whatsapp={SITE.whatsapp} />

    <InstagramEmbed username="jsdentalgrouprd" />

    <div data-animate="up">
      <Faq11
        client:visible
        heading="Preguntas frecuentes"
        note="Estas son algunas de las preguntas comunes sobre la clínica. Si no encuentras lo que buscas,"
        items={FAQS.map((f) => ({ question: f.q, answer: f.a }))}
        imageSrc={IMAGES.agendaCita3d}
      />
    </div>

    <div data-animate="up">
      <Contact2 client:visible />
    </div>
  </main>

  <FooterSection />
  <WhatsAppFloat />
</Layout>
