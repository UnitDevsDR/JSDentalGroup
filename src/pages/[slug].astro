---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FooterSection from '../components/FooterSection.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { Hero86 } from '../components/hero86';
import { Service5 } from '../components/service5';
import { Contact2 } from '../components/contact2';
import { SITE, SERVICES } from '../data/site';
import { servicePhoto, teamPhoto } from '../lib/images';

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;



// El titular enfatiza la última palabra (subrayado teal del bloque hero86)
const words = service.h1.split(' ');
const headingEmphasis = words.pop() ?? '';
const headingBefore = words.join(' ');

const relatedServices = SERVICES.filter((s) => s.slug !== service.slug)
  .slice(0, 4)
  .map((s) => ({ icon: s.icon, title: s.name, description: s.tagline, link: `/${s.slug}` }));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${SITE.url}/our-services` },
    { '@type': 'ListItem', position: 3, name: service.name, item: `${SITE.url}/${service.slug}` },
  ],
};

const procedureSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: service.name,
  description: service.metaDescription,
  procedureType: 'https://schema.org/NoninvasiveProcedure',
  provider: { '@id': `${SITE.url}/#clinic` },
};
---

<Layout
  title={service.title}
  description={service.metaDescription}
  extraSchema={[breadcrumbSchema, procedureSchema]}
>
  <SiteHeader />

  <main id="contenido" class="pt-16">
    <nav aria-label="Miga de pan" class="container pt-8 pb-4 text-sm text-muted-foreground">
      <a href="/" class="hover:text-teal">Inicio</a>
      <span aria-hidden="true"> / </span>
      <a href="/our-services" class="hover:text-teal">Servicios</a>
      <span aria-hidden="true"> / </span>
      <span class="text-navy">{service.name}</span>
    </nav>

    <Hero86
      tagline={service.tagline}
      headingBefore={headingBefore}
      headingEmphasis={headingEmphasis}
      description={service.longCopy}
      buttons={{
        primary: { text: 'Agenda tu evaluación', url: SITE.whatsapp },
        secondary: { text: SITE.phoneDisplay, url: `tel:${SITE.phone}` },
      }}
      specialist={{
        name: service.specialist.name,
        role: service.specialist.role,
        imageSrc: teamPhoto(service.specialist.image, 'lg'),
      }}
    />

    <Service5
      heading="¿En qué consiste este tratamiento?"
      intro={service.copy}
      photo={{ src: servicePhoto(service.slug), alt: `${service.name} en JS Dental Group, clínica dental en Santiago` }}
      specialist={{
        name: service.specialist.name,
        role: service.specialist.role,
        imageSrc: teamPhoto(service.specialist.image, 'sm'),
      }}
      relatedServices={relatedServices}
    />

    <div data-animate="up">
      <Contact2 client:visible title={`Agenda tu consulta de ${service.name}`} />
    </div>
  </main>

  <FooterSection />
  <WhatsAppFloat />
</Layout>
