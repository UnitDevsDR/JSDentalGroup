---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ContactSection from '../components/ContactSection.astro';
import FooterSection from '../components/FooterSection.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { SITE, SERVICES } from '../data/site';

// Las imágenes de servicio se resuelven dinámicamente desde src/assets
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/services/*.{webp,jpg,png}',
);

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;

const findImage = async (key: string) => {
  const entry = Object.entries(images).find(([path]) => {
    const base = path.split('/').pop() ?? '';
    return base.startsWith(key) && !base.includes('-2.');
  });
  return entry ? (await entry[1]()).default : null;
};
const mainImage = await findImage(service.image);

const otherServices = SERVICES.filter((s) => s.slug !== service.slug);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${SITE.url}/our-services` },
    { '@type': 'ListItem', position: 3, name: service.name, item: `${SITE.url}/${service.slug}` },
  ],
};

const procedureSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: service.name,
  description: service.metaDescription,
  procedureType: 'https://schema.org/NoninvasiveProcedure',
  provider: { '@id': `${SITE.url}/#clinic` },
};
---

<Layout
  title={service.title}
  description={service.metaDescription}
  extraSchema={[breadcrumbSchema, procedureSchema]}
>
  <SiteHeader />

  <main>
    <section class="relative overflow-hidden pt-32 pb-20 md:pt-40 md:pb-28">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div
          class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-gradient-to-br from-teal/10 to-navy/5 blur-3xl"
          data-parallax="-0.12"
        >
        </div>
        <div class="dot-grid absolute inset-0 opacity-30"></div>
      </div>

      <div class="container relative">
        <nav aria-label="Miga de pan" class="mb-8 text-sm text-muted-foreground" data-animate="up">
          <a href="/" class="hover:text-teal">Inicio</a>
          <span aria-hidden="true"> / </span>
          <a href="/our-services" class="hover:text-teal">Servicios</a>
          <span aria-hidden="true"> / </span>
          <span class="text-navy">{service.name}</span>
        </nav>

        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div>
            <h1
              data-animate="blur"
              class="mb-4 font-heading text-4xl leading-[1.08] font-bold text-navy sm:text-5xl lg:text-6xl"
            >
              {service.h1}
            </h1>
            <p data-animate="up" data-delay="0.15" class="mb-6 text-xl font-medium text-teal">
              {service.tagline}
            </p>
            <p data-animate="up" data-delay="0.25" class="mb-8 max-w-xl text-lg leading-relaxed text-muted-foreground">
              {service.copy}
            </p>
            <div data-animate="up" data-delay="0.35" class="flex flex-col gap-4 sm:flex-row">
              <a
                href={SITE.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-teal px-8 py-4 text-base font-semibold text-white shadow-lg shadow-teal/25 transition-all duration-300 hover:-translate-y-0.5"
              >
                Agenda tu evaluación
              </a>
              <a
                href={`tel:${SITE.phone}`}
                class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-navy/15 px-8 py-4 text-base font-semibold text-navy transition-colors hover:border-teal hover:text-teal"
              >
                {SITE.phoneDisplay}
              </a>
            </div>
          </div>

          {
            mainImage && (
              <div data-animate="scale" data-delay="0.2" class="relative">
                <div class="overflow-hidden rounded-3xl border-8 border-white shadow-2xl shadow-navy/15">
                  <Image
                    src={mainImage}
                    alt={`${service.name} en JS Dental Group, Santiago`}
                    width={880}
                    widths={[440, 880]}
                    sizes="(max-width: 1024px) 90vw, 520px"
                    loading="eager"
                    fetchpriority="high"
                    class="h-auto w-full"
                  />
                </div>
                <svg
                  class="smile-arc pointer-events-none absolute -bottom-8 left-1/2 w-[110%] -translate-x-1/2"
                  viewBox="0 0 400 120"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M20 20 C 110 130, 290 130, 380 20"
                    stroke="oklch(0.71 0.09 187)"
                    stroke-width="6"
                    stroke-linecap="round"
                    pathLength="1"
                  />
                </svg>
              </div>
            )
          }
        </div>
      </div>
    </section>

    <section class="bg-accent/50 py-16" aria-label="Otros servicios">
      <div class="container">
        <h2 class="mb-8 font-heading text-2xl font-semibold text-navy" data-animate="up">
          También te puede interesar
        </h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
          {
            otherServices.slice(0, 4).map((s) => (
              <a
                href={`/${s.slug}`}
                class="group rounded-xl border bg-card p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
              >
                <h3 class="mb-1 font-heading text-lg font-medium text-navy group-hover:text-teal">{s.name}</h3>
                <p class="text-sm text-muted-foreground">{s.tagline}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <ContactSection heading={`Agenda tu consulta de ${service.name}`} />
  </main>

  <FooterSection />
  <WhatsAppFloat />
</Layout>
