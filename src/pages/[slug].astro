---
import ServiceDetail from '../views/ServiceDetail.astro';
import { SERVICE_KEYS, SERVICE_SLUGS } from '../i18n';

export function getStaticPaths() {
  return SERVICE_KEYS.map((key) => ({
    params: { slug: SERVICE_SLUGS[key].es },
    props: { serviceKey: key },
  }));
}

const { serviceKey } = Astro.props;
---

<ServiceDetail lang="es" serviceKey={serviceKey} />
