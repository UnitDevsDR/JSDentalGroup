---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FooterSection from '../components/FooterSection.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { Hero1 } from '../components/hero1';
import { Contact2 } from '../components/contact2';
import { SITE, SERVICES } from '../data/site';
import { TEAM_IMAGES } from '../lib/team-images';

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;

const specialistImg = await getImage({ src: TEAM_IMAGES[service.specialist.image], width: 800 });
const otherServices = SERVICES.filter((s) => s.slug !== service.slug);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${SITE.url}/our-services` },
    { '@type': 'ListItem', position: 3, name: service.name, item: `${SITE.url}/${service.slug}` },
  ],
};

const procedureSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: service.name,
  description: service.metaDescription,
  procedureType: 'https://schema.org/NoninvasiveProcedure',
  provider: { '@id': `${SITE.url}/#clinic` },
};
---

<Layout
  title={service.title}
  description={service.metaDescription}
  extraSchema={[breadcrumbSchema, procedureSchema]}
>
  <SiteHeader />

  <main class="pt-16">
    <nav aria-label="Miga de pan" class="container pt-10 text-sm text-muted-foreground">
      <a href="/" class="hover:text-teal">Inicio</a>
      <span aria-hidden="true"> / </span>
      <a href="/our-services" class="hover:text-teal">Servicios</a>
      <span aria-hidden="true"> / </span>
      <span class="text-navy">{service.name}</span>
    </nav>

    <Hero1
      badge={service.name}
      heading={service.h1}
      tagline={service.tagline}
      description={service.longCopy}
      buttons={{
        primary: { text: 'Agenda tu evaluación', url: SITE.whatsapp },
        secondary: { text: SITE.phoneDisplay, url: `tel:${SITE.phone}` },
      }}
      specialist={{
        name: service.specialist.name,
        role: service.specialist.role,
        imageSrc: specialistImg.src,
      }}
    />

    <section class="bg-accent/50 py-16" aria-label="Sobre el tratamiento">
      <div class="container grid gap-10 lg:grid-cols-[2fr_1fr]">
        <div data-animate="up">
          <h2 class="mb-4 font-heading text-2xl font-semibold text-navy md:text-3xl">
            ¿En qué consiste?
          </h2>
          <p class="max-w-3xl text-lg leading-relaxed text-muted-foreground">{service.copy}</p>
        </div>
        <div data-animate="up" data-delay="0.15" class="rounded-2xl border bg-card p-6 shadow-sm">
          <p class="text-sm font-semibold tracking-widest text-teal uppercase">Especialista a cargo</p>
          <p class="mt-2 font-heading text-xl font-semibold text-navy">{service.specialist.name}</p>
          <p class="text-muted-foreground">{service.specialist.role}</p>
          <a
            href={SITE.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-teal hover:underline"
          >
            Agenda con {service.specialist.name.split(' ')[0]} {service.specialist.name.split(' ')[1]} →
          </a>
        </div>
      </div>
    </section>

    <section class="py-16" aria-label="Otros servicios">
      <div class="container">
        <h2 class="mb-8 font-heading text-2xl font-semibold text-navy" data-animate="up">
          También te puede interesar
        </h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
          {
            otherServices.slice(0, 4).map((s) => (
              <a
                href={`/${s.slug}`}
                class="group rounded-xl border bg-card p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
              >
                <h3 class="mb-1 font-heading text-lg font-medium text-navy group-hover:text-teal">{s.name}</h3>
                <p class="text-sm text-muted-foreground">{s.tagline}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <Contact2 client:visible title={`Agenda tu consulta de ${service.name}`} />
  </main>

  <FooterSection />
  <WhatsAppFloat />
</Layout>
