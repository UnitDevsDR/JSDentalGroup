---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import { SITE, TEAM, SERVICE_KEYS } from '../data/site';
import { IMAGES, teamPhoto } from '../lib/images';
import { LOCALES, ROUTES, servicePath, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** URL equivalente de esta página en cada idioma (hreflang + selector) */
  paths: Record<Lang, string>;
  ogImage?: string;
  /** JSON-LD adicional de la página (FAQPage, BreadcrumbList, MedicalProcedure…) */
  extraSchema?: object[];
  /** páginas que no deben indexarse (404) */
  noindex?: boolean;
  /** orígenes de terceros que esta página usa (embeds): abre la conexión antes */
  preconnect?: string[];
}

const {
  lang,
  title,
  description,
  paths,
  ogImage,
  extraSchema = [],
  noindex = false,
  preconnect = [],
} = Astro.props;
const t = useTranslations(lang);

const canonical = new URL(paths[lang], SITE.url).href;
const ogImageUrl = ogImage ?? new URL(IMAGES.og, SITE.url).href;

// Analítica y verificación: se activan con variables de entorno del build
// (PUBLIC_GTM_ID=GTM-XXXXXXX, PUBLIC_GSC_VERIFICATION=token)
const GTM_ID = import.meta.env.PUBLIC_GTM_ID;
const GSC_VERIFICATION = import.meta.env.PUBLIC_GSC_VERIFICATION;

// hreflang: un enlace por idioma + x-default al idioma por defecto
const HREFLANG: Record<Lang, string> = { es: 'es', en: 'en' };
const alternates = LOCALES.map((l) => ({
  hreflang: HREFLANG[l],
  href: new URL(paths[l], SITE.url).href,
}));

const CLINIC_ID = `${SITE.url}/#clinic`;
const WEBSITE_ID = `${SITE.url}/#website`;

// Una entidad por doctor: refuerza el E-E-A-T del equipo médico
const physicians = TEAM.filter((m) => m.title).map((m) => ({
  '@type': 'Physician',
  '@id': `${SITE.url}/#${m.key}`,
  name: `${t.titles[m.title!]} ${m.name}`,
  jobTitle: t.roles[m.key as keyof typeof t.roles],
  medicalSpecialty: t.roles[m.key as keyof typeof t.roles],
  image: new URL(teamPhoto(m.key, 'lg'), SITE.url).href,
  worksFor: { '@id': CLINIC_ID },
  url: new URL(ROUTES.about[lang], SITE.url).href,
}));

// Cada especialidad como servicio ofrecido por la clínica
const availableService = SERVICE_KEYS.map((key) => ({
  '@type': 'MedicalProcedure',
  '@id': new URL(servicePath(key, lang), SITE.url).href + '#procedure',
  name: t.services[key].name,
  description: t.services[key].tagline,
  url: new URL(servicePath(key, lang), SITE.url).href,
}));

const clinicSchema = {
  '@type': 'Dentist',
  '@id': CLINIC_ID,
  name: SITE.name,
  legalName: SITE.legalName,
  description: t.schema.clinicDescription,
  inLanguage: t.htmlLang,
  url: SITE.url,
  telephone: SITE.phone,
  email: SITE.email,
  foundingDate: String(SITE.founded),
  slogan: t.home.heroSlideTitle,
  priceRange: '$$',
  image: ogImageUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  geo: { '@type': 'GeoCoordinates', ...SITE.geo },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '12:00' },
  ],
  availableLanguage: [
    { '@type': 'Language', name: 'Spanish' },
    { '@type': 'Language', name: 'English' },
  ],
  sameAs: [SITE.instagram],
  logo: new URL(IMAGES.logo, SITE.url).href,
  medicalSpecialty: 'Dentistry',
  areaServed: [
    { '@type': 'City', name: SITE.address.city },
    { '@type': 'AdministrativeArea', name: `${SITE.address.region}, República Dominicana` },
  ],
  hasMap: `https://www.google.com/maps?q=${encodeURIComponent(SITE.address.mapQuery)}`,
  employee: physicians.map((p) => ({ '@id': p['@id'] })),
  availableService,
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  url: SITE.url,
  name: SITE.name,
  inLanguage: t.htmlLang,
  publisher: { '@id': CLINIC_ID },
};

const webPageSchema = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: t.htmlLang,
  isPartOf: { '@id': WEBSITE_ID },
  about: { '@id': CLINIC_ID },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl },
};

// Un solo bloque JSON-LD con el grafo completo: las entidades se referencian
// entre sí por @id en vez de repetirse en cada página
const graph = {
  '@context': 'https://schema.org',
  '@graph': [clinicSchema, ...physicians, websiteSchema, webPageSchema, ...extraSchema],
};
---

<!doctype html>
<html lang={t.htmlLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO primario -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Alternativas de idioma -->
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(paths.es, SITE.url).href} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={t.ogLocale} />
    {
      LOCALES.filter((l) => l !== lang).map((l) => (
        <meta property="og:locale:alternate" content={useTranslations(l).ogLocale} />
      ))
    }
    <meta property="og:site_name" content={SITE.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- SEO local -->
    <meta name="geo.region" content="DO-25" />
    <meta name="geo.placename" content={SITE.address.city} />

    <!-- Google Search Console -->
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

    <!-- Google Tag Manager (vía Partytown: corre en un web worker) -->
    {
      GTM_ID && (
        <script
          type="text/partytown"
          set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${GTM_ID}');`}
        />
      )
    }

    {preconnect.map((origin) => <link rel="preconnect" href={origin} crossorigin />)}

    <meta name="theme-color" content="#002554" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Datos estructurados -->
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="antialiased">
    {
      GTM_ID && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    <slot />

    <script>
      // Carrusel del hero: rota entre el equipo y los especialistas.
      // Vanilla para no hidratar React; pausa al pasar el cursor y respeta
      // prefers-reduced-motion.
      const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
      if (carousel) {
        const slides = [...carousel.querySelectorAll<HTMLImageElement>('[data-hero-slide]')];
        const nameEl = document.querySelector<HTMLElement>('[data-hero-name]');
        const roleEl = document.querySelector<HTMLElement>('[data-hero-role]');
        if (slides.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          // las imágenes diferidas se piden cuando la página ya cargó
          const preload = () => slides.forEach((el) => {
            const lazy = el.getAttribute('data-src');
            if (lazy) { el.src = lazy; el.removeAttribute('data-src'); }
          });
          if (document.readyState === 'complete') preload();
          else window.addEventListener('load', preload, { once: true });

          let index = 0;
          let paused = false;
          carousel.addEventListener('mouseenter', () => { paused = true; });
          carousel.addEventListener('mouseleave', () => { paused = false; });

          setInterval(() => {
            if (paused || document.hidden) return;
            slides[index].classList.replace('opacity-100', 'opacity-0');
            index = (index + 1) % slides.length;
            slides[index].classList.replace('opacity-0', 'opacity-100');
            const meta = slides[index].dataset;
            if (nameEl && meta.name) nameEl.textContent = meta.name;
            if (roleEl && meta.role) roleEl.textContent = meta.role;
          }, 4500);
        }
      }
    </script>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (prefersReducedMotion) {
        document.querySelectorAll<HTMLElement>('[data-animate]').forEach((el) => {
          el.style.opacity = '1';
        });
      } else {
        // Reveals por posición real en cada frame de scroll: a prueba de
        // saltos rápidos (ScrollTrigger once y el IntersectionObserver pueden
        // perderse el disparo cuando el elemento atraviesa el viewport entre
        // dos frames — el IO coalesce transiciones).
        const reveal = (el: HTMLElement) => {
          if (el.hasAttribute('data-stagger')) {
            gsap.set(el, { opacity: 1 });
            gsap.from(el.children, {
              opacity: 0,
              y: 40,
              duration: 0.7,
              ease: 'power3.out',
              stagger: 0.09,
            });
            return;
          }

          const direction = el.getAttribute('data-animate') || 'up';
          const delay = parseFloat(el.getAttribute('data-delay') || '0');

          const fromVars: gsap.TweenVars = { opacity: 0 };
          if (direction === 'up') fromVars.y = 56;
          if (direction === 'down') fromVars.y = -56;
          if (direction === 'left') fromVars.x = -56;
          if (direction === 'right') fromVars.x = 56;
          if (direction === 'scale') { fromVars.scale = 0.92; fromVars.y = 24; }
          if (direction === 'blur') { fromVars.filter = 'blur(12px)'; fromVars.y = 24; }

          gsap.fromTo(el, fromVars, {
            opacity: 1,
            x: 0,
            y: 0,
            scale: 1,
            filter: 'blur(0px)',
            duration: 0.9,
            delay,
            ease: 'power3.out',
          });
        };

        const pending = new Set<HTMLElement>(
          document.querySelectorAll<HTMLElement>('[data-animate], [data-stagger]'),
        );

        let checking = false;
        const check = () => {
          checking = false;
          const limit = window.innerHeight * 0.88;
          pending.forEach((el) => {
            if (el.getBoundingClientRect().top < limit) {
              pending.delete(el);
              reveal(el);
            }
          });
          if (pending.size === 0) {
            window.removeEventListener('scroll', onScroll);
            window.removeEventListener('resize', onScroll);
          }
        };
        const onScroll = () => {
          if (!checking) {
            checking = true;
            requestAnimationFrame(check);
          }
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        check();

        // Parallax: data-parallax="-0.2..0.3"
        document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
          const speed = parseFloat(el.getAttribute('data-parallax') || '0.2');
          gsap.to(el, {
            y: () => speed * 120,
            ease: 'none',
            scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true },
          });
        });

        // Contadores: data-count="1000" (+sufijo data-count-suffix) — mismo
        // mecanismo por posición que los reveals
        const pendingCounts = new Set<HTMLElement>(
          document.querySelectorAll<HTMLElement>('[data-count]'),
        );

        let checkingCounts = false;
        const checkCounts = () => {
          checkingCounts = false;
          const limit = window.innerHeight * 0.92;
          const numberLocale = document.documentElement.lang === 'en' ? 'en-US' : 'es-DO';
          pendingCounts.forEach((el) => {
            if (el.getBoundingClientRect().top < limit) {
              pendingCounts.delete(el);
              const target = parseInt(el.getAttribute('data-count') || '0', 10);
              const suffix = el.getAttribute('data-count-suffix') || '';
              const obj = { n: 0 };
              gsap.to(obj, {
                n: target,
                duration: 1.8,
                ease: 'power2.out',
                snap: { n: 1 },
                onUpdate: () => { el.textContent = `${obj.n.toLocaleString(numberLocale)}${suffix}`; },
              });
            }
          });
          if (pendingCounts.size === 0) window.removeEventListener('scroll', onScrollCounts);
        };
        const onScrollCounts = () => {
          if (!checkingCounts) {
            checkingCounts = true;
            requestAnimationFrame(checkCounts);
          }
        };
        window.addEventListener('scroll', onScrollCounts, { passive: true });
        checkCounts();

        // Firma: arco de sonrisa que se dibuja con el scroll
        document.querySelectorAll<SVGPathElement>('.smile-arc path').forEach((path) => {
          gsap.fromTo(
            path,
            { strokeDashoffset: 1 },
            {
              strokeDashoffset: 0,
              ease: 'none',
              scrollTrigger: { trigger: path.closest('section'), start: 'top 80%', end: 'bottom 60%', scrub: 0.6 },
            },
          );
        });
      }
    </script>
  </body>
</html>
