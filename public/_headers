# Headers de seguridad (Netlify / Cloudflare Pages).
# Si se despliega en Nginx/Dokploy, replicar estos headers en la config del server.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self'; frame-src 'self' https://www.google.com https://www.googletagmanager.com https://www.instagram.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; base-uri 'self'; form-action 'self' https://wa.me; object-src 'none'; upgrade-insecure-requests

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes con nombre SEO (sin hash): caché de 7 días + revalidación,
# así una imagen reemplazada se propaga sin quedar clavada un año
/img/*
  Cache-Control: public, max-age=604800, must-revalidate

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=604800
